# --- Core -------------------------------------------------------------------
# Docker Compose database (see docker-compose.yml)
DATABASE_URL="postgresql://relaydesk:relaydesk@localhost:5432/relaydesk?schema=public"
# Separate database used by `npm test` (it is wiped between test files)
TEST_DATABASE_URL="postgresql://relaydesk:relaydesk@localhost:5432/relaydesk_test?schema=public"
# Public base URL used in emails and Stripe redirects
APP_URL="http://localhost:3000"

# --- Customer ordering add-on (FastAPI + mobile) ------------------------------
# FastAPI ordering backend. The web app rewrites /api/py/* to this URL so the
# browser talks to it same-origin (session cookie flows, CSP stays 'self').
API_INTERNAL_URL="http://localhost:8000"
# The FastAPI service and the React Native app have their own env files:
#   apps/api/.env.example      (DATABASE_URL, APP_URL, CORS_ORIGINS, ENVIRONMENT, token TTLs)
#   apps/mobile/.env.example   (EXPO_PUBLIC_API_URL)
# The FastAPI service uses the SAME DATABASE_URL as this app (one database).

# --- Email --------------------------------------------------------------------
# "console" (default in development) logs emails and writes them to .dev-mail/
# "smtp" delivers via SMTP_URL (use in production)
# "ses" delivers via the Amazon SES API (needs SES_AWS_REGION; credentials from
#  SES_AWS_ACCESS_KEY_ID/SES_AWS_SECRET_ACCESS_KEY, or omit both to use an instance
#  role). The SES_AWS_ prefix avoids the reserved AWS_* names some hosts (e.g.
#  Netlify) forbid. EMAIL_FROM must be an SES-verified address or domain.
EMAIL_PROVIDER="console"
EMAIL_FROM="RelayDesk <no-reply@relaydesk.local>"
# SMTP_URL="smtps://user:pass@smtp.example.com:465"
# SES_AWS_REGION="ap-south-1"
# SES_AWS_ACCESS_KEY_ID=""
# SES_AWS_SECRET_ACCESS_KEY=""

# --- Features ----------------------------------------------------------------------
# Off unless "true". With sign-ups off, users cannot register or start new businesses;
# create accounts and the business with `npm run accounts:create`.
# With billing off, every workspace has full access and no plan limits.
SIGNUP_ENABLED="false"
BILLING_ENABLED="false"
# On unless "false": email every business member when clients, orders or payments change.
# CHANGE_EMAILS_ENABLED="true"

# --- Stripe (SaaS subscriptions) -----------------------------------------------
# Leave empty in development to use the built-in billing simulator.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_STARTER=""
STRIPE_PRICE_PRO=""

# --- Razorpay (SaaS subscriptions; PLATFORM account) ---------------------------
# Suppliers pay RelayDesk here. Map each tier to a Razorpay Plan id in the
# operator console (Plans). End-customer ORDER payments use each supplier's OWN
# Razorpay keys, stored per-business in Settings — never these platform keys.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# --- Plans (optional overrides; empty = unlimited where noted) --------------------
# PLAN_STARTER_MAX_MEMBERS=3
# PLAN_STARTER_MAX_MONTHLY_ORDERS=200
# PLAN_PRO_MAX_MEMBERS=25
# PLAN_PRO_MAX_MONTHLY_ORDERS=        # empty = unlimited
# TRIAL_DAYS=14
# PAST_DUE_GRACE_DAYS=7

# --- Jobs ------------------------------------------------------------------------
# Shared secret for POST /api/cron/daily (Authorization: Bearer <secret>)
CRON_SECRET="change-me"

# --- Deployment / hardening ------------------------------------------------------------
# Number of reverse proxies in front of the app that append to X-Forwarded-For
# (1 = one load balancer). 0 = app is exposed directly (X-Real-IP is used).
# TRUSTED_PROXY_HOPS=1
# Max Postgres connections per app instance
# DATABASE_POOL_MAX=10
# Required when running more than one app instance (32-byte base64 key:
#   openssl rand -base64 32). Must be identical on every instance.
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
# Extra origins allowed to call server actions if your proxy rewrites Host
# SERVER_ACTIONS_ALLOWED_ORIGINS="app.example.com"
# Production refuses EMAIL_PROVIDER=console unless this is set (staging only)
# ALLOW_CONSOLE_EMAIL=1
# The seed script refuses NODE_ENV=production unless this is set (staging only)
# SEED_ALLOW_PRODUCTION=1

# --- Platform admin bootstrap ---------------------------------------------------------
# Comma-separated emails promoted to platform admin by the seed script
PLATFORM_ADMIN_EMAILS="admin@relaydesk.local"
